{
    "name": "madiunkab/bukusaku-mpp-backend",
    "type": "project",
    "description": "Backend RESTful API & 3-Layer Hybrid RAG Engine untuk BUKU SAKU MPP AI Kabupaten Madiun",
    "keywords": ["laravel", "madiun", "mpp", "perizinan", "rag", "ai-assistant"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
